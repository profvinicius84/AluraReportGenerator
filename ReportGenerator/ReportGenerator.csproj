<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Alura Report Generator</Title>
    <Authors>Professor Vinícius</Authors>
    <Version>1.0.0</Version>
    <Company>Alura</Company>
    <Description>Biblioteca de geração de relatórios</Description>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Alura_ReportGenerator</PackageId>
    <Version>1.1.0</Version>
    <Authors>Prof Vinícius Costa Santos</Authors>
    <Company>Alura</Company>
    <Description>A library for generating reports in various formats.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/profvinicius84/AluraReportGenerator</RepositoryUrl>
    <PackageProjectUrl>https://github.com/profvinicius84/AluraReportGenerator</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext7" Version="7.2.5" />
  </ItemGroup>

</Project>
